{
	"name": "@repo/api-clients",
	"version": "1.0.0",
	"description": "Collection of API clients for different services",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./visma-sign-api": {
			"import": "./src/visma-sign-api/client.ts",
			"require": "./src/visma-sign-api/client.ts",
			"types": "./src/visma-sign-api/client.ts"
		},
		"./share-link-api": {
			"import": "./src/share-link-api/client.ts",
			"require": "./src/share-link-api/client.ts",
			"types": "./src/share-link-api/client.ts"
		},
		"./base-client": {
			"import": "./src/base-client.ts",
			"require": "./src/base-client.ts",
			"types": "./src/base-client.ts"
		},
		"./types": {
			"import": "./src/types.ts",
			"require": "./src/types.ts",
			"types": "./src/types.ts"
		},
		"./configs": {
			"import": "./src/configs.ts",
			"require": "./src/configs.ts",
			"types": "./src/configs.ts"
		}
	},
	"dependencies": {
		"axios": "^1.6.0"
	},
	"devDependencies": {
		"typescript": "^5.0.0"
	},
	"keywords": [
		"api",
		"client",
		"axios",
		"typescript",
		"rest"
	],
	"author": "",
	"license": "MIT"
}
